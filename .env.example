# Copy this file to ".env" and fill in your Supabase project values.
# Find them in your Supabase dashboard: Project Settings -> API.
# The anon/public key is safe to expose in the browser (protected by RLS).
# NEVER put the service_role key or DB password in a VITE_ variable.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
